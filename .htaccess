# ป้องกันไฟล์ตั้งค่า
<FilesMatch "^(config\.php|config\.local\.php|\.user\.ini|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
Options -Indexes

# ขีดจำกัดการอัปโหลด (Apache + mod_php; ถ้าใช้ PHP-FPM ระบบจะอ่านจาก .user.ini)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value max_file_uploads 30
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value max_file_uploads 30
</IfModule>
