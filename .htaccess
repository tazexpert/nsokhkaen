# ป้องกันไฟล์ตั้งค่า
<FilesMatch "^(config\.php|config\.local\.php|\.user\.ini|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
Options -Indexes

# ไฟล์/โฟลเดอร์ซ่อน (.git .env .gitignore ...) และไฟล์เอกสาร/สำรอง/log ห้ามเปิดจากเว็บ (มีผลทุกโฟลเดอร์ย่อย)
RedirectMatch 404 "/\.(git|svn|hg|env|idea|vscode)(/|$)"
<FilesMatch "(^\.|\.(md|sql|log|bak|old|orig|swp|sh|py|ini|dist|lock)$)">
    Require all denied
</FilesMatch>

# Security headers สำหรับไฟล์ static (.html .css .js รูป) — หน้า PHP ส่ง header เองจาก core/security.php
<IfModule mod_headers.c>
    Header setifempty X-Content-Type-Options "nosniff"
    Header setifempty X-Frame-Options "SAMEORIGIN"
    Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# CSP สำหรับหน้า .html (เว็บไซต์ศูนย์ดิจิทัลชุมชน) — ค่าเดียวกับ security_csp() ใน core/security.php (แก้ให้ตรงกันทั้งสองที่)
<IfModule mod_headers.c>
    <FilesMatch "\.html?$">
        Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://code.jquery.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://cdn.jsdelivr.net https://*.tile.openstreetmap.org https://server.arcgisonline.com; connect-src 'self' https://cdn.jsdelivr.net; frame-src 'self' https://app.powerbi.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        Header set Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
    </FilesMatch>
</IfModule>

# ขีดจำกัดการอัปโหลด (Apache + mod_php; ถ้าใช้ PHP-FPM ระบบจะอ่านจาก .user.ini)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value max_file_uploads 30
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value max_file_uploads 30
</IfModule>

# URL ไม่มี .php (ต้องเปิด mod_rewrite — XAMPP เปิดไว้แล้ว และ AllowOverride All)
#   /modules/calendar/plan?m=2026-11  → plan.php · ลิงก์เดิม/QR Code ที่มี .php ยังใช้ได้ (GET ถูกพาไป URL ใหม่)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # 1) GET/HEAD ที่ขอ xxx.php โดยตรง → 301 ไป URL ไม่มี .php (POST ไม่ redirect เพราะข้อมูลฟอร์มจะหาย)
    #    THE_REQUEST = บรรทัดคำขอจริงจากเบราว์เซอร์ (ไม่วนซ้ำหลัง rewrite ภายใน)
    #    (query string เดิมต่อท้ายให้อัตโนมัติ — ไม่ใส่ ? ใน backreference เพราะ Apache 2.4.60+ ปฏิเสธ)
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\ (/[^?\ ]*/)index\.php[?\ ] [NC]
    RewriteRule ^ %2 [R=301,L,NE]
    RewriteCond %{THE_REQUEST} ^(GET|HEAD)\ (/[^?\ ]+)\.php[?\ ] [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ %2 [R=301,L,NE]
    # 2) ภายใน: /xxx → xxx.php (ถ้ามีไฟล์ และไม่ใช่โฟลเดอร์)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
