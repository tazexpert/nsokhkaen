<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: ห้ามเปิดไฟล์ในโฟลเดอร์นี้จากเว็บ (แทน .htaccess "Require all denied") — PHP ยังอ่านไฟล์ได้ตามปกติ -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />
        <rule name="ห้ามเข้าถึง" stopProcessing="true">
          <match url=".*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
