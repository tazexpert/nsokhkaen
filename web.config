<?xml version="1.0" encoding="UTF-8"?>
<!--
  ตั้งค่าสำหรับ IIS (แทน .htaccess ของ Apache) — ดูขั้นตอนติดตั้งที่ docs/IIS.md
  ต้องติดตั้ง: ฟีเจอร์ CGI (FastCGI สำหรับ PHP) และโมดูล URL Rewrite 2.1
  โฟลเดอร์ที่ห้ามเปิดจากเว็บมี web.config ของตัวเอง (core libs database storage tools docs uploads/…)
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />

    <!-- URL ไม่มี .php: /modules/calendar/plan?m=2026-11 → plan.php · ลิงก์เดิม/QR Code ที่มี .php ยังใช้ได้ -->
    <rewrite>
      <rules>
        <!-- 1) GET/HEAD ขอ …/index.php โดยตรง → 301 ไป …/ (POST ไม่ redirect เพราะข้อมูลฟอร์มจะหาย) -->
        <rule name="ตัด index.php" stopProcessing="true">
          <match url="(^|/)index\.php$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
            <add input="{URL}" pattern="^(.*/)index\.php$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="{C:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <!-- 2) GET/HEAD ขอ xxx.php ที่มีไฟล์จริง → 301 ไป xxx -->
        <rule name="ตัด .php" stopProcessing="true">
          <match url="\.php$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_METHOD}" pattern="^(GET|HEAD)$" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{URL}" pattern="^(.+)\.php$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="{C:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <!-- 3) ภายใน: xxx → xxx.php (ถ้ามีไฟล์ และไม่ใช่โฟลเดอร์) -->
        <rule name="เติม .php" stopProcessing="true">
          <match url="^(.+?)/?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.php" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.php" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- ขนาดคำขอสูงสุด 64 MB ให้ตรงกับ post_max_size (ค่าเริ่มต้น IIS 30 MB) -->
        <requestLimits maxAllowedContentLength="67108864" />
        <!-- ไฟล์ตั้งค่า / ไฟล์และโฟลเดอร์ซ่อน -->
        <hiddenSegments>
          <add segment="config.php" />
          <add segment="config.local.php" />
          <add segment=".git" />
          <add segment=".gitignore" />
          <add segment=".user.ini" />
          <add segment=".htaccess" />
          <add segment="legacy-redirects" />
        </hiddenSegments>
        <!-- ไฟล์เอกสาร/สำรอง/log/สคริปต์ ห้ามเปิดจากเว็บ (มีผลทุกโฟลเดอร์ย่อย) -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".old" allowed="false" />
          <add fileExtension=".orig" allowed="false" />
          <add fileExtension=".swp" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".dist" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".dat" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- ชนิดไฟล์ฟอนต์/รูปที่ IIS บางรุ่นไม่รู้จัก (remove ก่อนกันซ้ำกับค่าของเซิร์ฟเวอร์) -->
    <staticContent>
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <!-- หน้า PHP ส่ง security header เองจาก core/security.php — ที่นี่แค่ซ่อนข้อมูลเซิร์ฟเวอร์ -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- ให้ข้อความแจ้งเตือนของระบบ (403/404/500 จาก PHP) แสดงตามเดิม ไม่ถูกแทนด้วยหน้า error ของ IIS -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

  <!-- หน้าเว็บไซต์ศูนย์ดิจิทัลชุมชน (.html) — CSP เดียวกับ security_csp() ใน core/security.php (แก้ให้ตรงกันทั้งสองที่) -->
  <location path="digital.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
          <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://code.jquery.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://cdn.jsdelivr.net https://*.tile.openstreetmap.org https://server.arcgisonline.com; connect-src 'self' https://cdn.jsdelivr.net; frame-src 'self' https://app.powerbi.com; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" />
          <add name="Permissions-Policy" value="camera=(self), geolocation=(self), microphone=(), payment=(), usb=()" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
